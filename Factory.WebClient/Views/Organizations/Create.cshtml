@model Factory.Domain.Dto.OrganizationDto

@{
    ViewData["Title"] = "Новая организация";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="form-group">
        <label asp-for="Name">Наименование</label>
        <input asp-for="Name" type="text" />
        <span asp-validation-for="Name" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Address">Адрес</label>
        <textarea asp-for="Address" rows="2"></textarea>
        <span asp-validation-for="Address" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ContactNumber">Контактный номер</label>
        <input asp-for="ContactNumber" type="text" />
        <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
    </div>

    <div>
        <button type="submit">Создать</button>
        <a asp-action="Index" class="btn">Назад к списку</a>
    </div>
</form>