@model IEnumerable<ContractQueryDto>

@{
    ViewData["Title"] = "Договоры";
}

<h1>Договоры</h1>

<p>
    <a asp-action="Create">Добавить договор</a>
</p>

<table>
    <thead>
    <tr>
        <th>Id</th>
        <th>Организация</th>
        <th>Сотрудник</th>
        <th>Дата договора</th>
        <th>Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.OrganizationName</td>
            <td>@item.EmployeeFullName</td>
            <td>@(item.ContractDate?.ToString("dd.MM.yyyy") ?? "—")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Изменить</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" onclick="return confirm('Удалить договор #@item.Id?');">Удалить</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>