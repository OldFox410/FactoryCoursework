@model IEnumerable<PaymentQueryDto>

@{
    ViewData["Title"] = "Платежи";
}

<h1>Платежи</h1>

<form method="get" asp-action="Index">
    <input type="date" name="StartDate" />
    <input type="date" name="EndDate" />
    <button type="submit">Фильтровать</button>
    <a asp-action="Index">Сбросить</a>
</form>

<p>
    <a asp-action="Create">Добавить платёж</a>
</p>

<table>
    <thead>
    <tr>
        <th>Id</th>
        <th>ФИО</th>
        <th>Дата</th>
        <th>Сумма</th>
        <th>Премия</th>
        <th>Штраф</th>
        <th>Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.EmployeeFullName</td>
            <td>@item.PaymentMonth.ToString("dd.MM.yyyy")</td>
            <td>@item.SalaryAmount.ToString("N2")</td>
            <td>@item.Bonus.ToString("N2")</td>
            <td>@item.Fine.ToString("N2")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Изменить</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" onclick="return confirm('Удалить платёж #@item.Id?');">Удалить</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>